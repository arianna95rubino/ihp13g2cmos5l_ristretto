C {devices/code_shown.sym} 0 -720 0 0 {name=NGSPICE only_toplevel=true 
value="
.temp 27
.param fin=1K
.param amp=1m
.control
.options gmin=1e-9 rshunt=1e12 reltol=1e-3 abstol=1e-9 vntol=1e-6

option sparse
save all

.nodeset vmem_up = 1.2
.nodeset vmem_dn = 1.2
op
write feature_extr_withbuf.raw
set appendwrite

tran 100n 2m
write feature_extr_withbuf.raw
*wrdata amplification.csv vin_p vin_n vout_amp
*wrdata comparison.csv vout_up vout_dn vthr_h vthr_l i(v.x1.vmeas1) i(v.x1.vmeas3)
*wrdata event_conversion.csv req_up req_dn vmem_up vmem_dn


plot v(req_up) v(req_dn)
plot v(vmem_up) v(vmem_dn)


.endc
"}
C {devices/code_shown.sym} 0 -140 0 0 {name=MODEL only_toplevel=true
format="tcleval( @value )"
value="
.lib cornerMOSlv.lib mos_tt
