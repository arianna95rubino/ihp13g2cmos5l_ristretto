C {devices/lab_wire.sym} 732.5 -727.5 0 0 {name=p4 sig_type=std_logic lab=vin_p}
C {devices/lab_wire.sym} 802.5 -667.5 0 0 {name=p7 sig_type=std_logic lab=vin_n}
